# Copy to backend/.env and fill in values. Never commit the real .env file.

ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://aurax:aurax@localhost:5432/aurax

# Optional: personal access token used ONLY on the backend to raise GitHub
# API rate limits and access private repositories. Never required for
# public repository analysis. Never logged, never returned in API
# responses, never written to reports.
GITHUB_TOKEN=

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=10
GITHUB_MAX_RETRIES=3

CLONE_TIMEOUT_SECONDS=120
MAX_REPOSITORY_SIZE_MB=500
MAX_COMMIT_HISTORY=200
